#!/bin/bash
#
# Dump the IBSng database to a plain SQL file (optionally gzip-compressed
# when the target name ends in .gz).
#
# Environment:
#   IBS_BACKUP_DB          database name     (default: IBSng)
#   IBS_BACKUP_NO_SU=1     run pg_dump as the current user instead of
#                          "su postgres" - for containers / non-standard
#                          layouts where PGHOST, PGPORT, PGUSER and
#                          PGPASSWORD already describe the connection

set -euo pipefail

DB_NAME="${IBS_BACKUP_DB:-IBSng}"

case "$DB_NAME" in
  *[!A-Za-z0-9_]* | "")
    echo "Error: invalid database name '$DB_NAME'." >&2
    exit 1
    ;;
esac

if [ $# -ne 1 ] || [ -z "$1" ]; then
  echo "Error: Backup path is missing."
  echo "Usage: $0 /path/to/backup.sql[.gz]"
  exit 1
fi
BACKUP_PATH="$1"

dump_db() {
  if [ "${IBS_BACKUP_NO_SU:-0}" = "1" ] || [ "$(id -un)" = "postgres" ]; then
    pg_dump "$DB_NAME"
  else
    su postgres -c "pg_dump '$DB_NAME'"
  fi
}

case "$BACKUP_PATH" in
  *.gz)
    dump_db | gzip -9 > "$BACKUP_PATH"
    ;;
  *)
    dump_db > "$BACKUP_PATH"
    ;;
esac

echo "Your backup is ready at: $BACKUP_PATH"
